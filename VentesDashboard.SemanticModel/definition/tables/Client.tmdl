				    #"Inserted Merged Column" = Table.AddColumn(dbo_Client, "Adresse complète", each Text.Combine({[Adresse], [Ville], [CodePostal], [Pays]}, ","), type text),
				    #"Renamed Columns" = Table.RenameColumns(#"Inserted Merged Column",{{"ContactNom", "Nom complet client"}})
				in
				    #"Renamed Columns"

