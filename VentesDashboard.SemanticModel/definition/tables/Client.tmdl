	column 'Adresse complète'
		dataType: string
		lineageTag: b791ac4c-c4b5-45b9-97c4-0135bf5f696b
		summarizeBy: none
		sourceColumn: Adresse complète

		annotation SummarizationSetBy = Automatic

	column 'Segment Client' = ```
			
			-- Remplace 'Commande'[Montant] par le champ exact du chiffre d'affaires dans ta table de faits
			VAR CASociete = 
			    CALCULATE(
			        SUM(LigneCommandes[CA]), 
			        ALLEXCEPT('Client', 'Client'[NomSociete])
			    )
			
			-- Table des CA par société active
			VAR TableCA = 
			    SUMMARIZE(
			        ALL('Client'), 
			        'Client'[NomSociete], 
			        "TotalCA", CALCULATE(SUM(LigneCommandes[CA]))
			    )
			
			VAR TableCAActif = FILTER(TableCA, [TotalCA] > 0)
			
			-- Calcul des seuils globaux fixes
			VAR P50 = PERCENTILEX.INC(TableCAActif, [TotalCA], 0.50)
			VAR P80 = PERCENTILEX.INC(TableCAActif, [TotalCA], 0.80)
			VAR P95 = PERCENTILEX.INC(TableCAActif, [TotalCA], 0.95)
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(CASociete) || CASociete = 0, "Inactif",
			    CASociete < P50, "Occasionnel",
			    CASociete < P80, "Fréquent",
			    CASociete < P95, "VIP",
			    "TOP"
			)
			
			
			
			
			
			```
		lineageTag: 055c2f32-3a21-47b3-b068-ed62bc1fdc7d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

