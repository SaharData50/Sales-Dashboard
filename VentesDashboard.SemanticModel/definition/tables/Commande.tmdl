table Commande
	lineageTag: e38d9782-4797-4df3-a325-6902b457e7cb

	measure %Commande7jours =
			DIVIDE(
			    CALCULATE( DISTINCTCOUNT(Commande[CommandeId]),FILTER(Commande,Commande[DelaiExpedition]<7)),
			    CALCULATE(DISTINCTCOUNT(Commande[CommandeId]),REMOVEFILTERS()),0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 6d5f64ba-bf53-48af-ac66-083aae0c82da

	measure %Commande =
			DIVIDE(
			    CALCULATE( DISTINCTCOUNT(Commande[CommandeId])),
			    CALCULATE(DISTINCTCOUNT(Commande[CommandeId]),REMOVEFILTERS()),0
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a52b0fdb-ad70-458a-9e32-a519f3749ee8

	column CommandeId
		dataType: int64
		formatString: 0
