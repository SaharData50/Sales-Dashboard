	column Transport
		dataType: decimal
		formatString: #,0.###############\ "€";-#,0.###############\ "€";#,0.###############\ "€"
		lineageTag: ba43d831-1687-4dfe-9652-a056b1b3ae79
		summarizeBy: sum
		sourceColumn: Transport

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"fr-FR"}

	column DelaiExpedition = DATEDIFF(Commande[DateCommande],Commande[DateExpedition],DAY)
		formatString: 0
		lineageTag: c77743bf-e9b4-4176-b890-d31afedbf33f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DelaiLivraison = INT(Commande[DateDemandee]-Commande[DateExpedition])
		formatString: 0
